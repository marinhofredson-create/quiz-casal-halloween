<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Quiz do Casal Halloween — Fred & Irene</title>
<style>
:root{
  --bg:#09060d;
  --panel:#160e1d;
  --panel2:#211328;
  --orange:#ff7a18;
  --orange2:#ffad45;
  --purple:#8b3dff;
  --pink:#ff4d9d;
  --cream:#fff5e8;
  --muted:#cdbfd3;
  --green:#7cffad;
  --red:#ff6276;
  --gold:#ffd36f;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;background:#050308;color:var(--cream);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;overflow:hidden}
button,select,input{font:inherit}

#app{width:100vw;height:100vh;position:relative;background:#050308}
.screen{position:absolute;inset:0;display:none}
.screen.active{display:block}

#home{
  background-image:url("home.jpg");
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
}
#home::after{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.08));
  pointer-events:none;
}
.hotspot{
  position:absolute;
  border:none;
  background:transparent;
  cursor:pointer;
  z-index:3;
  border-radius:18px;
  outline:none;
}
.hotspot:focus-visible{
  box-shadow:0 0 0 4px rgba(255,255,255,.85),0 0 0 8px rgba(255,122,24,.85);
}
.hotspot:hover{
  background:rgba(255,255,255,.035);
  box-shadow:0 0 28px rgba(255,122,24,.2) inset;
}
#playHot{left:52.4%;top:60.3%;width:40.5%;height:14.4%}
#howHot{left:30.8%;top:84.7%;width:15.9%;height:11.5%}
#scoreHot{left:47.9%;top:84.7%;width:15.3%;height:11.5%}
#settingsHot{left:64.2%;top:84.7%;width:17%;height:11.5%}
#roundsHot{left:82%;top:84.7%;width:16%;height:11.5%}
#audioHot{left:91.5%;top:1.1%;width:6.5%;height:8.7%}

.hiddenLabel{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0
}

.modal{
  position:absolute;inset:0;display:none;align-items:center;justify-content:center;
  background:rgba(4,2,8,.78);backdrop-filter:blur(10px);z-index:20;padding:3vw;
}
.modal.show{display:flex}
.modalBox{
  width:min(780px,88vw);
  background:linear-gradient(180deg,rgba(34,20,43,.98),rgba(18,11,24,.98));
  border:1px solid rgba(255,255,255,.12);
  border-radius:28px;
  padding:30px;
  box-shadow:0 30px 90px rgba(0,0,0,.55),0 0 40px rgba(156,77,255,.12);
}
.modalBox h2{font-size:34px;margin:0 0 12px}
.modalBox p,.modalBox li{color:var(--muted);font-size:18px;line-height:1.5}
.modalActions{display:flex;gap:12px;justify-content:flex-end;margin-top:22px;flex-wrap:wrap}
.btn{
  min-height:52px;padding:0 20px;border:none;border-radius:15px;font-weight:900;cursor:pointer;
}
.btn.primary{background:linear-gradient(90deg,#ff9b3d,#ff6918);color:#1a0902}
.btn.secondary{background:#28172f;color:#f6e6ff;border:1px solid rgba(255,255,255,.1)}
.btn.green{background:rgba(124,255,173,.13);color:#b9ffd0;border:1px solid rgba(124,255,173,.23)}
.btn.red{background:rgba(255,98,118,.12);color:#ffb4c0;border:1px solid rgba(255,98,118,.22)}

#game{
  background:
    radial-gradient(circle at 10% 8%,rgba(116,37,189,.32),transparent 26%),
    radial-gradient(circle at 91% 7%,rgba(255,107,26,.24),transparent 28%),
    linear-gradient(135deg,#050309,#100716 55%,#07040c);
  padding:1.25vw;
}
.gameShell{height:100%;display:flex;flex-direction:column;gap:.85vw}
.gameTop{
  flex:0 0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1vw;
}
.backBtn,.audioBtn{
  min-height:48px;padding:0 16px;border-radius:14px;border:1px solid rgba(255,255,255,.11);
  background:#17101d;color:#fff;cursor:pointer;font-weight:800;
}
.gameTitle{text-align:center;font-size:clamp(22px,1.9vw,40px);font-weight:1000;letter-spacing:.03em}
.topRight{display:flex;justify-content:flex-end;gap:.7vw;align-items:center}
.counter,.scoreBox{
  padding:.55vw .85vw;border-radius:999px;border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.05);font-size:clamp(13px,.82vw,18px);font-weight:800
}
.mainBoard{
  flex:1 1 auto;min-height:0;display:grid;grid-template-columns:30% 1fr;gap:1vw;
}
.leftPanel,.rightPanel{
  min-height:0;border-radius:26px;border:1px solid rgba(255,255,255,.09);overflow:hidden;
  background:linear-gradient(180deg,rgba(30,17,38,.96),rgba(14,8,20,.98));
  box-shadow:0 24px 60px rgba(0,0,0,.35);
}
.leftPanel{position:relative}
.leftPhoto{width:100%;height:100%;object-fit:cover;object-position:center 28%;display:block;filter:saturate(1.05) contrast(1.03)}
.leftOverlay{
  position:absolute;inset:0;background:linear-gradient(180deg,transparent 46%,rgba(5,3,8,.2) 62%,rgba(5,3,8,.88) 100%);
  pointer-events:none
}
.coupleTag{
  position:absolute;left:5%;right:5%;bottom:4%;padding:12px 14px;border-radius:18px;
  background:rgba(10,6,14,.72);border:1px solid rgba(255,255,255,.12);
  text-align:center;font-size:clamp(18px,1.25vw,26px);font-weight:1000;backdrop-filter:blur(10px)
}
.rightPanel{display:flex;flex-direction:column;padding:1.25vw 1.4vw;position:relative}
.rightPanel::after{
  content:"🕸️";position:absolute;right:-.5vw;top:-1vw;font-size:8vw;opacity:.07;pointer-events:none
}
.categoryRow{display:flex;align-items:center;justify-content:space-between;gap:1vw}
.categoryBadge{
  display:inline-flex;align-items:center;gap:.45vw;padding:.55vw .9vw;border-radius:999px;
  background:rgba(156,77,255,.13);border:1px solid rgba(156,77,255,.28);
  color:#e1ccff;font-size:clamp(12px,.82vw,18px);font-weight:1000;letter-spacing:.05em;text-transform:uppercase
}
.turnBadge{
  color:#ffd9b5;font-size:clamp(14px,.95vw,21px);font-weight:900
}
.cardStage{flex:1;display:flex;align-items:center;justify-content:center;perspective:1300px;min-height:0;padding:.4vw 0}
.questionCard{
  width:100%;height:84%;max-height:540px;min-height:320px;
  border-radius:28px;border:1px solid rgba(255,255,255,.11);
  background:
   radial-gradient(circle at 86% 12%,rgba(255,122,24,.14),transparent 26%),
   radial-gradient(cir
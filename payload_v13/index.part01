ons">
        <button class="smallBtn good" id="guessHit" type="button">Acertou +1</button>
        <button class="smallBtn bad" id="guessMiss" type="button">Errou</button>
      </div>
    </div>
  </div>
</div>

<script>
const qs=(s)=>document.querySelector(s);
const qsa=(s)=>[...document.querySelectorAll(s)];

const pools={
  gostos:[
    "Qual comida te deixa feliz quase instantaneamente?",
    "Qual filme ou série você reveria sem cansar?",
    "Qual música combina mais com a sua fase atual?",
    "Praia, serra ou cidade grande: qual viagem combina mais com você?",
    "Qual pequeno luxo do dia a dia você não abre mão?",
    "Qual presente te emociona mais: útil, romântico ou surpresa?",
    "Qual programa simples a dois você considera perfeito?",
    "Qual coisa boba sempre consegue te fazer rir?",
    "Qual cheiro te traz uma memória boa?",
    "Que sobremesa você escolheria agora sem pensar duas vezes?"
  ],
  sonhos:[
    "Qual viagem você mais quer fazer nos próximos anos?",
    "Como seria a casa dos seus sonhos?",
    "Qual conquista profissional você ainda quer muito viver?",
    "Que experiência gostaria de viver em casal pelo menos uma vez?",
    "Se dinheiro não fosse problema, como seria um ano perfeito?",
    "Qual hábito você gostaria de construir junto com alguém?",
    "Você se imagina morando em outra cidade ou país um dia?",
    "Qual sonho seu pouca gente conhece?",
    "Que lembrança gostaria de construir comigo daqui a um ano?",
    "O que significa ter uma vida boa para você?"
  ],
  conexao:[
    "O que mais te chamou atenção em mim no começo?",
    "Em que momento percebeu que estava se envolvendo de verdade?",
    "Qual lembrança desses quatro meses você guardaria numa cápsula do tempo?",
    "O que te faz sentir mais cuidado numa relação?",
    "Qual gesto meu te deixa mais confortável perto de mim?",
    "O que nós fazemos melhor quando estamos juntos?",
    "Qual qualidade minha combina mais com a sua?",
    "Que encontro nosso você gostaria de repetir?",
    "O que gostaria que eu entendesse melhor sobre você?",
    "Qual foi a surpresa mais positiva que teve sobre mim?"
  ],
  misterio:[
    "Qual pergunta você sempre quis me fazer, mas ainda não fez?",
    "Se eu tivesse um segredo inocente, sobre o que você acha que seria?",
    "Qual mania minha você acha que já conseguiu decifrar?",
    "Qual detalhe meu percebeu antes de eu contar?",
    "Se pudesse ler um pensamento meu por 10 segundos, quando escolheria?",
    "Qual coisa sobre mim você acha que ainda vai descobrir?",
    "Quem provavelmente se assusta primeiro em um filme de terror?",
    "Se nossa história fosse um suspense, qual seria o título?",
    "Qual foi o maior mistério sobre mim que você já desvendou?",
    "Qual seria a pergunta perfeita para me deixar sem resposta?"
  ],
  picante:[
    "Qual clima deixa um encontro mais sedutor para você?",
    "Qual elogio meu mexe mais com você?",
    "O que torna um beijo inesquecível para você?",
    "Qual momento nosso teve mais química até agora?",
    "Você prefere romance devagar ou uma surpresa mais ousada?",
    "Qual detalhe no visual de alguém você acha especialmente atraente?",
    "Qual seria o cenário perfeito para uma noite romântica?",
    "Qual tipo de carinho costuma te arrepiar mais?",
    "O que cria mais tensão boa: olhar, conversa, toque ou surpresa?",
    "Qual música combina com uma noite mais intensa entre nós?"
  ]
};

let state={names:["Fred","Irene"],score:0,round:0,total:18,turn:0,deck:[],started:false};
const catMap={gostos:["🍿","GOSTOS"],sonhos:["🌙","SONHOS"],conexao:["❤️","CONEXÃO"],misterio:["🔮","MISTÉRIO"],picante:["🌶️","PICANTE"]};

function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function buildDeck(){
  const intensity=qs("#intensity").value;
  let all=[];
  ["gostos","sonhos","conexao","misterio"].forEach(c=>pools[c].forEach(q=>all.push({cat:c,q})));
  if(intensity==="misto"||intensity==="picante"){
    pools.picante.forEach(q=>all.push({cat:"picante",q}));
    if(intensity==="picante") pools.picante.forEach(q=>all.push({cat:"picante",q}));
  }
  const seen=new Set(), deck=[];
  for(const item of shuffle(all)){
    const key=item.cat+"|"+item.q;
    if(!seen.has(key)){seen.add(key);deck.push(item)}
    if(deck.length>=state.total) break;
  }
  return deck;
}

function showScreen(id){qsa('.screen').forEach(x=>x.classList.remove('active'));qs(id).classList.add('active');}
function showModal(id){qs(id).classList.add('show');}
function hideModals(){qsa('.modal').forEach(m=>m.classList.remove('show'));}
qsa('.closeModal').forEach(b=>b.addEventListener('click',hideModals));
qsa('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)hideModals();}));

function updateScoreModal(){
  qs('#scoreModalValue').textContent=state.score;
  const p=state.total?state.score/state.total:0;
  qs('#scoreMessage').textContent=
    p>=.75?"Vocês estão assustadoramente sincronizados. A química venceu a assombração." :
    p>=.45?"Vocês já se conhecem bem, mas a mansão ainda guarda bons segredos." :
    "Ainda há muitos mistérios para descobrir — ótima desculpa para uma nova rodada.";
}

function toast(msg){
  const t=qs('#toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(window.__toast);
  window.__toast=setTimeout(()=>t.classList.remove('show'),1300);
}
function burst(){
  const c=qs('#confetti');
  const icons=['🎃','🦇','✨','🕯️','❤️'];
  for(let i=0;i<18;i++){
    const s=document.createElement('span');
    s.textContent=icons[Math.floor(Math.random()*icons.length)];
    s.style.left=(10+Math.random()*80)+'%';
    s.style.animationDelay=(Math.random()*.35)+'s';
    c.appendChild(s);
    setTimeout(()=>s.remove(),2200);
  }
}

function startGame(){
  if(!audio.running) startAudio();
  state.total=parseInt(qs('#roundCount').value,10);
  state.score=0; state.round=0; state.turn=Math.random()<.5?0:1; state.deck=buildDeck(); state.started=true;
  qs('#roundTotal').textContent=state.total;
  qs('#score').textContent='0';
  qs('#progressBar').style.width='0%';
  showScreen('#game');
  nextQuestion(true);
}

function nextQuestion(first=false){
  if(state.round>=state.total || state.round>=state.deck.length){ endGame(); return; }
  const card=qs('#questionCard');
  card.classList.add('flip');
  setTimeout(()=>{
    const item=state.deck[state.round];
    state.round++; state.turn=1-state.turn;
    const [icon,label]=catMap[item.cat];
    qs('#categoryBadge').textContent=icon+' '+label;
    qs('#turnBadge').textContent='Responde: '+state.names[state.turn];
    qs('#questionText').textContent=item.q;
    qs('#promptText').textContent='Conversem sem pressa. Vale rir, provocar e contar histórias.';
    qs('#roundNow').textContent=state.round;
    qs('#progressBar').style.width=((state.round/state.total)*100)+'%';
    card.classList.remove('flip');
    if(!first){ sfx('next'); toast('🦇 Nova pergunta revelada'); }
  },250);
}

function addPoint(){
  sfx('hit');
  state.score++;
  qs('#score').textContent=state.score;
  burst();
  toast('🕯️ +1 ponto de conexão');
}
function endGame(){ updateScoreModal(); showModal('#scoreModal'); }

qs('#playBtn').addEventListener('click',startGame);
qs('#howBtn').addEventListener('click',()=>showModal('#howModal'));
qs('#scoreBtn').addEventListener('click',()=>{updateScoreModal(); showModal('#scoreModal');});
qs('#settingsBtn').addEventListener('click',()=>showModal('#settingsModal'));
qs('#roundsBtn').addEventListener('click',()=>showModal('#roundsModal'));
qs('#backHome').addEventListener('click',()=>showScreen('#home'));
qs('#nextBtn').addEventListener('click',()=>nextQuestion());
qs('#hitBtn').addEventListener('click',()=>{addPoint(); setTimeout(()=>nextQuestion(),420);});
qs('#missBtn').addEventListener('click',()=>{sfx('miss'); toast('👻 Sem ponto desta vez'); setTimeout(()=>nextQuestion(),420);});
qs('#guessBtn').addEventListener('click',()=>{
  const other=state.names[1-state.turn], who=state.names[state.turn];
  qs('#guessText').textContent=other+' tenta adivinhar o que '+who+' responderia. Depois, '+who+' revela a resposta.';
  showModal('#guessModal');
});
qs('#guessHit').addEventListener('click',()=>{hideModals(); addPoint(); setTimeout(()=>nextQuestion(),420);});
qs('#guessMiss').addEventListener('click',()=>{hideModals(); sfx('miss'); toast('👻 O mistério continua'); setTimeout(()=>nextQuestion(),420);});

let audio={ctx:null,master:null,nodes:[],timers:[],running:false};
function ensureAudio(){
  const AC=window.AudioContext||window.webkitAudioContext; if(!AC) return null;
  if(!audio.ctx) audio.ctx=new AC();
  if(audio.ctx.state==='suspended') audio.ctx.resume();
  return audio.ctx;
}
function updateAudioButtons(){
  const label=audio.running?'🔊 Áudio':'🔇 Áudio';
  qs('#homeAudioBtn').textContent=label;
  qs('#gameAudio').textContent=audio.running?'🔊':'🔇';
  qs('#homeAudioBtn').classList.toggle('on',audio.running);
}
function sfx(type){
  const ctx=ensureAudio(); if(!ctx) return;
  const now=ctx.currentTime;
  const master=ctx.createGain(); master.gain.value=.12; master.connect(ctx.destination);
  if(type==='hit'){
    [392,523.25,659.25].forEach((f,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';o.frequency.value=f;g.gain.setValueAtTime(0,now+i*.05);g.gain.linearRampToValueAtTime(.09,now+i*.05+.02);g.gain.exponentialRampToValueAtTime(.001,now+i*.05+.42);o.connect(g);g.connect(master);o.start(now+i*.05);o.stop(now+i*.05+.48);});
  }else if(type==='miss'){
    const o=ctx.createOscillator(),g=ctx.createGain();o.type='sawtooth';o.frequency.setValueAtTime(135,now);o.frequency.exponentialRampToValueAtTime(48,now+.55);g.gain.setValueAtTime(.08,now);g.gain.exponentialRampToValueAtTime(.001,now+.58);o.connect(g);g.connect(master);o.start(now);o.stop(now+.6);
  }else{
    const o=ctx.createOscillator(),g=ctx.createGain();o.type='triangle';o.frequency.setValueAtTime(220,now);o.frequency.exponentialRampToValueAtTime(340,now+.16);g.gain.setValueAtTime(.05,now);g.gain.exponentialRampToValueAtTime(.001,now+.32);o.connect(g);g.connect(master);o.start(now);o.stop(now+.34);
  }
}
function stopAudio(){
  audio.running=false;
  audio.timers.forEach(clearTimeout); audio.timers=[];
  audio.nodes.forEach(n=>{try{n.stop&&n.stop();}catch(e){} try{n.disconnect&&n.disconnect();}catch(e){}}); audio.nodes=[];
  if(audio.master&&audio.ctx){try{audio.master.gain.cancelScheduledValues(audio.ctx.currentTime); audio.master.gain.setTargetAtTime(0,audio.ctx.currentTime,.08);}catch(e){}}
  updateAudioButtons();
}
function startAudio(){
  if(audio.running) return;
  const ctx=ensureAudio(); if(!ctx) return;
  const master=ctx.createGain(); master.gain.value=.07; master.connect(ctx.destination); audio.master=master; audio.running=true;
  [55,82.41,110].forEach((f,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type=i===1?'triangle':'sine';o.frequency.value=f;g.gain.value=i===0?.20:.06;o.connect(g);g.connect(master);o.start();audio.nodes.push(o,g);});
  const lfo=ctx.createOscillator(),lg=ctx.createGain();lfo.frequency.value=.11;lg.gain.value=.025;lfo.connect(lg);lg.connect(master.gain);lfo.start();audio.nodes.push(lfo,lg);
  const b=ctx.createBuffer(1,ctx.sampleRate*2,ctx.sampleRate), d=b.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*.19;
  const n=ctx.createBufferSource(), filter=ctx.createBiquadFilter(), ng=ctx.createGain(); n.buffer=b; n.loop=true; filter.type='lowpass'; filter.frequency.value=720; ng.gain.value=.045; n.connect(filter); filter.connect(ng); ng.connect(master); n.start(); audio.nodes.push(n,filter,ng);
  function bell(){ if(!audio.running) return; const now=ctx.currentTime; const o=ctx.createOscillator(),g=ctx.createGain(); o.type='sine'; o.frequency.value=[196,220,246.94,293.66][Math.floor(Math.random()*4)]; g.gain.setValueAtTime(0,now); g.gain.linearRampToValueAtTime(.08,now+.02); g.gain.exponentialRampToValueAtTime(.001,now+2.6); o.connect(g); g.connect(master); o.start(now); o.stop(now+2.7); audio.timers.push(setTimeout(bell,4800+Math.random()*5200)); }
  audio.timers.push(setTimeout(bell,1500));
  updateAudioButtons();
}
function toggleAudio(){ audio.running ? stopAudio() : startAudio(); }
qs('#homeAudioBtn').addEventListener('click',toggleAudio);
qs('#gameAudio').addEventListener('click',toggleAudio);
updateAudioButtons();

/* SELF TEST */
function assert(cond,msg,arr){arr.push((cond?'OK: ':'FAIL: ')+msg);}
function runSelfTest(){
  const results=[];
  audio.running=true;// disable recurring audio timers during self-test
  assert(!!qs('#playBtn') && !!qs('#howBtn') && !!qs('#scoreBtn') && !!qs('#settingsBtn') && !!qs('#roundsBtn'),'botões principais existem',results);
  const btns=['#playBtn','#howBtn','#scoreBtn','#settingsBtn','#roundsBtn'];
  assert(btns.every(sel=>{const r=qs(sel).getBoundingClientRect();return r.width>0&&r.height>0;}),'botões principais visíveis',results);
  // overlap check among menu buttons
  function overlap(a,b){return !(a.right<=b.left||b.right<=a.left||a.bottom<=b.top||b.bottom<=a.top)}
  const rects=btns.map(sel=>qs(sel).getBoundingClientRect());
  let noOverlap=true; for(let i=0;i<rects.length;i++){for(let j=i+1;j<rects.length;j++){if(overlap(rects[i],rects[j])) noOverlap=false;}}
  assert(noOverlap,'botões não se sobrepõem',results);
  qs('#howBtn').click(); assert(qs('#howModal').classList.contains('show'),'modal Como funciona abre',results); hideModals();
  qs('#settingsBtn').click(); assert(qs('#settingsModal').classList.contains('show'),'modal Configurações abre',results); hideModals();
  qs('#roundsBtn').click(); assert(qs('#roundsModal').classList.contains('show'),'modal Rodadas abre',results); hideModals();
  qs('#scoreBtn').click(); assert(qs('#scoreModal').classList.contains('show'),'modal Placar abre',results); hideModals();
  qs('#playBtn').click();
  setTimeout(()=>{
    assert(qs('#game').classList.contains('active'),'inicia o jogo',results);
    const before=qs('#roundNow').textContent;
    qs('#nextBtn').click();
    setTimeout(()=>{
      assert(qs('#roundNow').textContent!==before,'próxima pergunta avança rodada',results);
      const scoreBefore=Number(qs('#score').textContent); qs('#hitBtn').click();
      setTimeout(()=>{
        assert(Number(qs('#score').textContent)===scoreBefore+1,'acerto soma ponto',results);
        qs('#guessBtn').click(); assert(qs('#guessModal').classList.contains('show'),'modal adivinhar abre',results); hideModals();
        qs('#backHome').click(); assert(qs('#home').classList.contains('active'),'volta ao início',results);
        const panel=document.createElement('div'); panel.id='testResults'; panel.className='testPanel'; panel.textContent=results.join('\n'); document.body.appendChild(panel);
      },520);
    },320);
  },320);
}
if(location.search.includes('test=1')){window.addEventListener('load',()=>setTimeout(runSelfTest,250));}
</script>
</body>
</html>
